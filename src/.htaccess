Options -Indexes
RewriteEngine On

# Ne pas rewriter les vrais fichiers/dossiers
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rediriger vers HTTPS (décommenter en production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Frontoffice ---

# Page d'accueil
RewriteRule ^$ index.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Article : /article/mon-slug
RewriteRule ^article/([a-z0-9\-]+)/?$ frontoffice/article.php?slug=$1 [L,QSA]

# Catégorie : /categorie/mon-slug
RewriteRule ^categorie/([a-z0-9\-]+)/?$ frontoffice/categorie.php?slug=$1 [L,QSA]

# --- Backoffice ---

# Backoffice login
RewriteRule ^backoffice/?$ backoffice/login.php [L]
RewriteRule ^backoffice/login/?$ backoffice/login.php [L]
RewriteRule ^backoffice/logout/?$ backoffice/logout.php [L]
RewriteRule ^backoffice/dashboard/?$ backoffice/dashboard.php [L]
RewriteRule ^backoffice/articles/?$ backoffice/articles.php [L]
RewriteRule ^backoffice/article/nouveau/?$ backoffice/article_form.php [L]
RewriteRule ^backoffice/article/([0-9]+)/modifier/?$ backoffice/article_form.php?id=$1 [L,QSA]
RewriteRule ^backoffice/article/([0-9]+)/supprimer/?$ backoffice/article_delete.php?id=$1 [L,QSA]

# Bloquer l'accès aux fichiers sensibles
RewriteRule ^(connexion|backoffice/fonction|frontoffice/fonction)\.php$ - [F,L]
